theme = Catppuccin Mocha
font-family = Hack Nerd Font Mono
font-size = 13
font-feature = calt
font-feature = liga
font-feature = clig
font-feature = dlig

background-opacity = 0.9
background-blur-radius = 30
unfocused-split-opacity = 0.7
background-opacity-cells = true

cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 2

selection-background = #585b70
selection-foreground = #cdd6f4

window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-save-state = always
window-new-tab-position = current
window-title-font-family = Hack Nerd Font Mono
macos-titlebar-style = transparent
macos-non-native-fullscreen = true
macos-window-shadow = true
macos-option-as-alt = true

shell-integration-features = sudo
confirm-close-surface = false

# run fastfetch with random waifu on terminal start
command = ~/.local/bin/ghostty-init

copy-on-select = clipboard
mouse-hide-while-typing = true

adjust-cell-height = 2
adjust-cell-width = -1


# Copy selected text, otherwise pass Ctrl+C through
keybind = performable:ctrl+c=copy_to_clipboard

# Paste using physical Command+V
keybind = ctrl+v=paste_from_clipboard
