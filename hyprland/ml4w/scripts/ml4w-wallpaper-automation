#!/usr/bin/env bash
# Start or stop wallpaper automation
CACHE_FOLDER="$HOME/.cache/ml4w/hyprland-dotfiles"
PID_FILE="$CACHE_FOLDER/wallpaper-automation"

if [ -f "$PID_FILE" ]; then
  kill $(cat "$PID_FILE") 2>/dev/null || true
  rm "$PID_FILE"
  touch "$CACHE_FOLDER/restart-wpauto"
  exit 0
fi

while true; do
  sleep 3600
  "$HOME/.config/ml4w/scripts/ml4w-wallpaper-app --random"
done &
echo $! > "$PID_FILE"
