#!/usr/bin/env bash

notify_user() {
    local icon="dialog-information"
    local urgency="normal"
    local time="3000"
    local app="System"
    local summary=""
    local message=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
        --icon|--i|-i) icon="$2"; shift 2 ;;
        --urgency|--u|-u) urgency="$2"; shift 2 ;;
        --app|--a|-a) app="$2"; shift 2 ;;
        --time|--t|-t) time="$2"; shift 2 ;;
        --summary|--s|-s) summary="$2"; shift 2 ;;
        --message|--m|-m) message="$2"; shift 2 ;;
        --extra|--e|-e) shift 2 ;;
        *) echo "notify_user: unknown option: $1" >&2; return 1 ;;
        esac
    done

    [[ -z "$summary" ]] && summary="$app"
    notify-send -u "$urgency" -t "$time" -i "$icon" -a "$app" "$summary" "$message"
}
